# CoreIntra configuration.
#
# The same artifact runs vendor-managed and on-prem; only this file differs.
# Copy to .env and edit. `make up` refuses to start if .env is missing.

# --- Identity of this installation -------------------------------------------
COREINTRA_INSTALLATION_NAME=Acme Corp Intranet
# Korean is the default locale on a fresh install.
COREINTRA_DEFAULT_LOCALE=ko

# --- Database ----------------------------------------------------------------
POSTGRES_DB=coreintra
POSTGRES_USER=coreintra
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-before-first-boot
POSTGRES_PORT=5432

# --- Application -------------------------------------------------------------
COREINTRA_HTTP_PORT=8080
# Signing key for session tokens. Rotating it signs everyone out, which is the
# intended emergency behaviour. Generate with: openssl rand -base64 48
COREINTRA_SESSION_SIGNING_KEY=change-me-before-first-boot

# Where document bytes and uploaded fonts live. A local volume, deliberately:
# no cloud object store is assumed. See the BlobStore interface if you want one.
COREINTRA_BLOB_PATH=/var/lib/coreintra/blobs
COREINTRA_FONT_PATH=/var/lib/coreintra/fonts

# --- Conversion worker -------------------------------------------------------
# The heaviest component: headless LibreOffice + Korean fonts + a Node runtime
# for mdv rendering. Sized explicitly rather than left to autoscale, because
# each LibreOffice process is expensive and an unbounded pool will exhaust RAM
# before it exhausts CPU. See docs/deploy/sizing.md for the arithmetic.
COREINTRA_CONVERSION_URL=http://conversion-worker:3000
COREINTRA_CONVERSION_POOL_SIZE=3
# Small documents convert inline up to this timeout; anything longer becomes an
# async job with a polled id.
COREINTRA_CONVERSION_SYNC_TIMEOUT_MS=8000

# --- Mail (optional) ---------------------------------------------------------
# Leave blank to run without mail. Email-OTP as a second factor and email
# notifications are then HIDDEN rather than broken.
COREINTRA_SMTP_HOST=
COREINTRA_SMTP_PORT=587
COREINTRA_SMTP_USERNAME=
COREINTRA_SMTP_PASSWORD=
COREINTRA_SMTP_FROM=

# --- Optional modules --------------------------------------------------------
# When false, the accounting module's tables, endpoints, MCP tools and UI are
# absent. The rest of the system is unaffected; a test asserts this.
COREINTRA_ACCOUNTING_ENABLED=true

# --- Support access ----------------------------------------------------------
# Set to true to permanently disable temporary master account issuance for this
# installation. Once a client sets this, no master can re-enable it from the UI.
COREINTRA_TEMPORARY_MASTER_DISABLED=false
